{
  "name": "cadslate2d-web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "wasm:release": "../scripts/build-wasm.sh --release",
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm:release && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "bench:transport": "playwright test --config playwright.bench.config.ts --project=chromium transport",
    "bench:curves": "playwright test --config playwright.bench.config.ts --project=chromium curves",
    "bench:styles": "playwright test --config playwright.bench.config.ts --project=chromium styles",
    "bench:linetypes": "playwright test --config playwright.bench.config.ts --project=chromium linetypes",
    "bench:text": "playwright test --config playwright.bench.config.ts --project=chromium text",
    "bench:persistence": "playwright test --config playwright.bench.config.ts persistence",
    "bench:mixed": "playwright test --config playwright.bench.config.ts mixed",
    "bench:main-thread": "playwright test --config playwright.bench.config.ts main-thread"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "binaryen": "^132.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.24.0"
}
